<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the netcorehost framework feature in crates/orrin-script. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Needed for `unsafe`, function pointers, and [UnmanagedCallersOnly]. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Emit Orrin.runtimeconfig.json next to the DLL so the Rust host can load
         it via hostfxr's initialize_for_runtime_config. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- Orrin.xml beside Orrin.dll is where a game project's editor finds the
         API's documentation, in every layout: a project outside the checkout
         references this output directory by path. It is a developer's file,
         so the publish an export ships whole leaves it out. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- CS1591 is satisfied by a plain `///` line, which no editor displays.
         Orrin.MathTests asks for a <summary> on every script-facing member
         instead, and names what it exempts: the engine's entry points, which
         are public only so the host can call them. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Debug.DrawLine/DrawRay are [Conditional("ORRIN_DEBUG")]. Define the symbol
       in Debug builds so the calls compile in; leave it undefined in Release
       (export) builds so the compiler strips the call sites. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);ORRIN_DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- ORRIN001: a Behaviour field that is neither registry-visible nor
         [Transient]. `OutputItemType="Analyzer"` is what makes the compiler load
         it rather than link it; `ReferenceOutputAssembly="false"` keeps Roslyn
         out of the game assembly's own dependency set. -->
    <ProjectReference Include="../Orrin.Analyzers/Orrin.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
