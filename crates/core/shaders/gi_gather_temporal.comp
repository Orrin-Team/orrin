#version 460
#extension GL_EXT_samplerless_texture_functions : require

// The final gather's temporal filter: this frame's ray added into a running
// mean of the rays this texel's surface has had, with a count of how many
// frames that is (Mattausch et al. 2010). The mean is a plain one until the
// count reaches the cap, and keeps a fixed share after.
//
// The history is found where the prepass's motion says this texel's surface
// was, as a bilinear blend of the four texels round that point, each taken
// only where it was written for a surface at the distance this one would have
// stood from last frame's camera. None is a disocclusion: the count starts
// again, and the spatial filter after this widens to cover the one sample.
//
// The cap is led by how far the rays disagree, as a probe's history is
// (`gi_update.comp`): the history setting where a ray strays from the mean by
// about twice the mean, and longer by the square of how much further, up to
// `LONGEST`. A room lit through an arch by a sunlit floor takes most of its
// light from the few rays in ten thousand that meet the floor, and a mean of
// a few dozen frames either flickers with them or, held to its own spread,
// leaves them out: a bound on each ray's light at eight deviations above the
// mean cost an aisle nearly half its light, so nothing is held back. The
// disagreement is the change of the mean of the nine rays round the texel
// from one frame to the next, pooled over the twenty-five texels round it:
// one texel meets such a floor too seldom to know it is there, and a change
// between successive frames, unlike a spread about a lagging mean, does not
// grow while the light is rising or falling. It is taken against the mean of
// the histories of the eight texels two away, not this texel's own: a window
// that lengthens where its own mean has fallen and shortens where it has risen
// settles below the light it averages, a tenth below in Sponza's gallery.
//
// A light switched on would take as long as that cap to arrive, so the
// probes' test of a short mean against the long one, in its standard errors,
// on one frame and the next, restarts the count where the light has risen.
// Only risen, and only where the mean of the nine rays less their two
// brightest has risen too: where a few rays carry the light, the short mean
// sits under the long one between them and jumps over it on each, which is
// no switch either way. A texel that has restarted averages half the history
// setting for a few seconds, while the light goes on arriving bounce after
// bounce. Light that falls is left to the cap, which is short where a lamp
// lights a room, since its rays agree.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_depth;
layout(set = 0, binding = 1) uniform texture2D u_normal;
layout(set = 0, binding = 2) uniform texture2D u_velocity;
layout(set = 0, binding = 3) uniform texture2DArray u_raw;
layout(set = 0, binding = 4) uniform texture2DArray u_history;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2DArray u_accumulated;
#define ORRIN_GATHER_BLOCK_BINDING 6
#include "gi_gather.glsl"

// The relative variance of one ray at which the history is the setting.
const float AGREE = 4.0;
const float LONGEST = 1024.0;
// Texels either side the disagreement is pooled over.
const int POOL = 2;
// The switch test, as `gi_update.comp` has it: the short mean's share of each
// frame, the spread's, the standard errors over the line, and the share of
// the larger mean the two must be apart by as well; and how many times the
// long mean the short one must be, unless the count is young.
const float SHORT = 0.25;
const float SPREAD = 1.0 / 16.0;
const float STRIKE = 2.5;
const float CHANGED = 3.5;
const float CHANGED_LEAST = 0.25;
const float SETTLED = 4.0;
const float SWITCHED = 3.0;
const float YOUNG = 16.0;
// The count a restart leaves, and the frames after it the history is held to
// half the setting.
const float RESTARTED = 4.0;
const float SETTLING = 256.0;

float mean_of(vec4 sh[3]) {
    return dot(vec3(sh[0].x, sh[1].x, sh[2].x), GATHER_LUMA);
}

float raw_luminance(ivec2 low) {
    return dot(vec3(texelFetch(u_raw, ivec3(low, 0), 0).x,
                    texelFetch(u_raw, ivec3(low, 1), 0).x,
                    texelFetch(u_raw, ivec3(low, 2), 0).x), GATHER_LUMA);
}

void main() {
    ivec2 low = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_accumulated).xy;
    if (any(greaterThanEqual(low, size))) {
        return;
    }
    ivec2 full = textureSize(u_depth, 0);
    ivec2 texel = gather_texel(low, full);
    float depth = texelFetch(u_depth, texel, 0).r;
    if (depth_is_far(depth)) {
        for (int layer = 0; layer < GATHER_META; ++layer) {
            imageStore(u_accumulated, ivec3(low, layer), vec4(0.0));
        }
        imageStore(u_accumulated, ivec3(low, GATHER_META), vec4(0.0, 0.0, GATHER_REACH, 0.0));
        imageStore(u_accumulated, ivec3(low, GATHER_STATS), vec4(0.0));
        return;
    }
    vec3 position = gather_position(texel, depth, full);
    vec3 normal = gather_normal(texel);
    float far = distance(position, gather.camera.xyz);

    vec4 sample_sh[3];
    for (int layer = 0; layer < 3; ++layer) {
        sample_sh[layer] = texelFetch(u_raw, ivec3(low, layer), 0);
    }
    vec4 sample_meta = texelFetch(u_raw, ivec3(low, GATHER_META), 0);

    vec4 history[3] = vec4[3](vec4(0.0), vec4(0.0), vec4(0.0));
    vec4 held = vec4(0.0);
    vec4 held_stats = vec4(0.0);
    float total = 0.0;
    float pooled = 0.0;
    float pooled_count = 0.0;
    float pooled_level = 0.0;
    float levels = 0.0;
    vec2 previous = (vec2(texel) + 0.5) / vec2(full) - texelFetch(u_velocity, texel, 0).rg;
    if ((gather.params.z & GATHER_HISTORY) != 0u
            && all(greaterThanEqual(previous, vec2(0.0)))
            && all(lessThanEqual(previous, vec2(1.0)))) {
        // Where this surface stood from last frame's camera, if it stood
        // still; and a tolerance that widens as the surface turns edge-on,
        // where one texel spans more depth.
        float expected = distance(position, gather.previous_camera.xyz);
        vec3 view = normalize(gather.camera.xyz - position);
        float tolerance = 0.02 + expected * 0.03 / max(abs(dot(normal, view)), 0.2);
        vec2 at = gather_coordinate(previous * vec2(full));
        ivec2 base = ivec2(floor(at));
        vec2 f = at - vec2(base);
        for (int i = 0; i < 4; ++i) {
            ivec2 corner = ivec2(i & 1, i >> 1);
            ivec2 q = base + corner;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) {
                continue;
            }
            vec4 meta = texelFetch(u_history, ivec3(q, GATHER_META), 0);
            if (meta.x < 0.5 || abs(meta.y - expected) > tolerance) {
                continue;
            }
            vec2 w2 = mix(1.0 - f, f, vec2(corner));
            float w = w2.x * w2.y;
            for (int layer = 0; layer < 3; ++layer) {
                history[layer] += texelFetch(u_history, ivec3(q, layer), 0) * w;
            }
            held += meta * w;
            held_stats += texelFetch(u_history, ivec3(q, GATHER_STATS), 0) * w;
            total += w;
        }
        for (int y = -POOL; y <= POOL; ++y) {
            for (int x = -POOL; x <= POOL; ++x) {
                ivec2 q = clamp(base + ivec2(x, y), ivec2(0), size - 1);
                vec4 meta = texelFetch(u_history, ivec3(q, GATHER_META), 0);
                if (meta.x > 0.5) {
                    pooled += meta.w * meta.w;
                    pooled_count += 1.0;
                    if (((x | y) & 1) == 0 && (x != 0 || y != 0)) {
                        pooled_level += dot(vec3(texelFetch(u_history, ivec3(q, 0), 0).x,
                                                 texelFetch(u_history, ivec3(q, 1), 0).x,
                                                 texelFetch(u_history, ivec3(q, 2), 0).x), GATHER_LUMA);
                        levels += 1.0;
                    }
                }
            }
        }
    }
    float count = 0.0;
    if (total > 1e-3) {
        for (int layer = 0; layer < 3; ++layer) {
            history[layer] /= total;
        }
        held /= total;
        held_stats /= total;
        count = floor(held.x + 0.5);
    }

    // The mean of the nine rays round this one, and the same less the two
    // brightest.
    float rays[9];
    float around = 0.0;
    for (int i = 0; i < 9; ++i) {
        rays[i] = raw_luminance(clamp(low + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), size - 1));
        around += rays[i];
    }
    around /= 9.0;
    float first = 0.0;
    float second = 0.0;
    for (int i = 0; i < 9; ++i) {
        second = max(second, min(first, rays[i]));
        first = max(first, rays[i]);
    }
    float middle = (around * 9.0 - first - second) / 7.0;
    float mean = mean_of(history);
    float recent = held_stats.x;
    float disagreement = abs(held_stats.y);
    bool struck = held_stats.y < 0.0;
    float since = held_stats.z + 1.0;
    bool over = false;
    if (count < 0.5) {
        recent = around;
        disagreement = 0.0;
        since = SETTLING;
    } else {
        float delta = around - recent;
        recent += SHORT * delta;
        disagreement = sqrt(mix(disagreement * disagreement, delta * (around - recent), SPREAD));
        float apart = abs(recent - mean);
        float error = disagreement * sqrt(SHORT / (2.0 - SHORT));
        bool far_off = count >= SETTLED && apart > CHANGED_LEAST * max(mean, recent);
        over = far_off && apart > STRIKE * error;
        bool switched = recent > mean && middle > mean && (count < YOUNG || recent > SWITCHED * mean);
        if (struck && far_off && switched && apart > CHANGED * error) {
            count = min(count, RESTARTED);
            since = 0.0;
            over = false;
        }
    }

    // One ray's variance from that of the nine rays' mean between frames:
    // nine times, and half, for the two frames a change is the difference of.
    float level = levels > 0.0 ? pooled_level / levels : mean;
    float variance = pooled_count > 0.0 ? 4.5 * pooled / pooled_count / max(level * level, 1e-12) : 0.0;
    float cap = clamp(gather.camera.w * variance / AGREE, gather.camera.w, max(LONGEST, gather.camera.w));
    if (since < SETTLING) {
        cap = max(gather.camera.w * 0.5, 1.0);
    }
    float frames = min(count + 1.0, cap);
    float keep = 1.0 - 1.0 / frames;
    if (count < 0.5) {
        keep = 0.0;
    }
    vec4 mixed[3];
    for (int layer = 0; layer < 3; ++layer) {
        mixed[layer] = mix(sample_sh[layer], history[layer], keep);
        imageStore(u_accumulated, ivec3(low, layer), half_nearest(mixed[layer]));
    }
    // How far the nine rays' mean moved since last frame, as a running root
    // mean square over as many frames as the light is averaged over.
    float step = count < 0.5 ? 0.0 : around - held_stats.w;
    float noise = sqrt(mix(step * step, held.w * held.w, keep));
    imageStore(u_accumulated, ivec3(low, GATHER_META),
               half_nearest(vec4(frames, far, mix(sample_meta.z, held.z, keep), min(noise, 65000.0))));
    imageStore(u_accumulated, ivec3(low, GATHER_STATS),
               half_nearest(vec4(recent, (over ? -1.0 : 1.0) * (min(disagreement, 65000.0) + 1e-6),
                                min(since, SETTLING), around)));
}
