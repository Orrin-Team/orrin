#version 460

#include "depth.glsl"

// Motion blur, step one: the largest motion in each 16x16 tile.
//
// The gather cannot simply follow each pixel's own velocity. A fast object's
// blur has to reach *past* its silhouette onto the background it is sweeping
// across, and those background pixels are not moving — asked about themselves,
// they would report no motion and stay sharp, leaving the object crisply cut
// out against a still background. So the gather is driven by the strongest
// motion anywhere nearby, and decides per sample whether that motion actually
// belongs over this pixel. This pass and the neighbour-max after it are what
// make "anywhere nearby" cost one texture read instead of a search.
//
// The shutter and the radius clamp are applied here, at the top of the chain,
// so every pass below works in final screen-space blur vectors and there is one
// place where a frame's motion becomes an exposure.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_velocity;
layout(set = 0, binding = 1) uniform sampler2D u_depth;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D u_target;
layout(set = 0, binding = 3) uniform Params {
    // Unjittered, and used only where nothing was rasterised — see below.
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    // x = shutter fraction, y = max blur radius in pixels.
    vec4 params;
} mb;

// Side of a tile, in pixels. Must equal the shift the graph sizes this image by,
// or the tiles and the image they index disagree at the frame's edge.
const int TILE = 16;

// This frame's screen-space motion at one texel, in pixels, already scaled by
// the shutter and clamped to what the gather can reach.
//
// The clamp is not only a quality bound: the prepass writes a deliberately huge
// vector where a surface was behind last frame's camera, as a signal that no
// history exists. TAA reads that as "reproject off-screen and reject"; here it
// would be a blur streak across the whole frame, so it saturates instead.
vec2 blur_vector(ivec2 at, ivec2 size) {
    float depth = texelFetch(u_depth, at, 0).r;
    vec2 uv = (vec2(at) + 0.5) / vec2(size);

    vec2 velocity;
    if (depth_is_far(depth)) {
        // Nothing was rasterised, so the prepass wrote no motion — but the sky
        // still sweeps when the camera turns. Reproject the far-plane point
        // through both view-projections to recover exactly that. Without this
        // the geometry smears while the sky behind it stays perfectly sharp,
        // which reads as a bug rather than as a camera.
        vec4 world = mb.inv_view_proj * vec4(uv * 2.0 - 1.0, DEPTH_FAR, 1.0);
        vec4 previous = mb.prev_view_proj * vec4(world.xyz / world.w, 1.0);
        velocity = uv - ((previous.xy / previous.w) * 0.5 + 0.5);
    } else {
        velocity = texelFetch(u_velocity, at, 0).rg;
    }

    vec2 pixels = velocity * vec2(size) * mb.params.x;
    float length_pixels = length(pixels);
    float limit = mb.params.y;
    return length_pixels > limit ? pixels * (limit / length_pixels) : pixels;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_target);
    if (any(greaterThanEqual(texel, size))) {
        return;
    }

    ivec2 full_size = textureSize(u_velocity, 0);
    ivec2 base = texel * TILE;

    vec2 longest = vec2(0.0);
    float longest_length = 0.0;
    for (int y = 0; y < TILE; ++y) {
        for (int x = 0; x < TILE; ++x) {
            ivec2 at = base + ivec2(x, y);
            if (any(greaterThanEqual(at, full_size))) {
                continue;
            }
            vec2 candidate = blur_vector(at, full_size);
            float candidate_length = length(candidate);
            if (candidate_length > longest_length) {
                longest_length = candidate_length;
                longest = candidate;
            }
        }
    }

    // An RGBA target for a two-component value, because a storage image is only
    // guaranteed to support rg16f with an optional device feature while rgba16f
    // is always available. At one texel per 256 the waste is not worth a feature
    // flag on the device.
    imageStore(u_target, texel, vec4(longest, 0.0, 0.0));
}
