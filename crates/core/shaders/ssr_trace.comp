#version 460
#ifdef ORRIN_RAY_FALLBACK
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#endif

// One reflection ray per 2x2 quad of the frame, for every surface the
// reflections reach, returning the radiance it found and how much that radiance
// should be believed.
//
// The ray is the exact reflection, and the surface's roughness is the blur
// `trace_reflection` reads the hit through — so a ray per quad is a sampling
// rate of a smooth image, not a sample of a noisy one, and `ssr_resolve.comp`
// gathers these into each pixel as a small spatial blur. A surface smooth
// enough for that blur to show traces the rest of its quad there instead.
//
// The G-buffer is read at exactly the pixel the ray starts from
// (`ray_texel`): the quad is a sampling rate, not a lower-resolution copy of
// the surface.
//
// What comes out is incoming radiance, not a shaded value. The composite applies
// the same split-sum weight to it that the forward pass applied to the
// environment, because its job is to swap one for the other.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_hiz;      // nearest-depth pyramid
layout(set = 0, binding = 1) uniform sampler2D u_depth;    // full-res depth
layout(set = 0, binding = 2) uniform sampler2D u_normal;   // view-space, encoded
layout(set = 0, binding = 3) uniform sampler2D u_material; // rgb = f0, a = roughness
layout(set = 0, binding = 4) uniform sampler2D u_source;   // the lit frame, as a pyramid
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D u_rays;
layout(set = 0, binding = 6) uniform Ssr {
    mat4 proj;
    mat4 inv_proj;
    mat4 inv_view;
    // x = max roughness, y = thickness (metres), z = intensity, w unused
    vec4 params;
    // x = max steps, y = max distance (metres), z = pyramid levels above the
    // depth buffer, w unused
    vec4 trace;
    // xy = full-resolution extent, zw = its reciprocal
    vec4 extent;
    // x = sin(environment yaw), y = cos, z = specular mip count
    vec4 env;
    vec4 env_tint;
} ssr;
layout(set = 0, binding = 7) uniform sampler2D u_source_full; // the lit frame itself

#ifdef ORRIN_RAY_FALLBACK
#include "ray_shade.glsl"
#endif
#include "ssr_march.glsl"

void main() {
    ivec2 quad = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(quad, imageSize(u_rays)))) {
        return;
    }
    ivec2 full = textureSize(u_depth, 0);
    ivec2 texel = ray_texel(quad, full);

    float roughness = texelFetch(u_material, texel, 0).a;
    float depth = texelFetch(u_depth, texel, 0).r;
    vec4 ray = vec4(0.0);
    // The far plane is sky: nothing was rasterised, so there is no surface to
    // reflect off.
    if (!depth_is_far(depth) && roughness <= ssr.params.x) {
        vec2 uv = (vec2(texel) + 0.5) / vec2(full);
        vec3 n = normalize(texelFetch(u_normal, texel, 0).xyz * 2.0 - 1.0);
        ray = trace_reflection(uv, depth, n, roughness);
    }
    imageStore(u_rays, quad, ray);
}
