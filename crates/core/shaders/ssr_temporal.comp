#version 460

#include "depth.glsl"

// The reflection's denoiser: gather this frame's quarter-rate rays around
// each pixel, then accumulate the result into a history that holds the
// reflection alone.
//
// Except on a mirror. Below `MIRROR_ROUGHNESS` the ray is the exact
// reflection, so it is the answer rather than a sample of it: gathering
// neighbours could only blur it and accumulating frames could only lag it, and
// the pixel traces its own ray here, at full resolution, and takes it as it
// is. Every ray drawn from a lobe is accumulated, however narrow the lobe —
// one that is not leaves grain that never settles. Between `MIRROR_ROUGHNESS`
// and `GLOSSY_ROUGHNESS` the pixel's own ray and the quarter-rate gather
// cross-fade, so a surface whose roughness crosses from one regime to the
// other shows no line — the same `trace_reflection` produces both.
//
// Its own history rather than TAA's, because TAA's clip runs on the composited
// frame, where a reflection's noise cannot be told from texture: it either clips
// the noise back in every frame, which flickers, or lets it through as grain.
// Clipped here, the box is the spread of the reflection's own rays.
//
// The history is reprojected two ways. A reflection does not move with the
// surface showing it but with what it reflects, which sits `ray length` further
// down the camera ray — so a mirror's history is found by reprojecting that
// virtual point. A rough reflection is a blur that mostly does move with the
// surface, and a miss has no length at all, so the surface's own motion vector
// is the other candidate. Whichever sits closer to this frame's neighbourhood
// is taken, with a thumb on the scale for the virtual point on smooth surfaces.
//
// What it writes is still incoming radiance and how much of it to believe; the
// composite in `ssr_resolve.comp` is what turns that into the frame's colour.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_rays;       // one per quad, rgb + confidence
layout(set = 0, binding = 1) uniform sampler2D u_ray_length; // one per quad, metres, 0 = miss
layout(set = 0, binding = 2) uniform sampler2D u_depth;
layout(set = 0, binding = 3) uniform sampler2D u_normal;     // view-space, encoded
layout(set = 0, binding = 4) uniform sampler2D u_material;   // rgb = f0, a = roughness
layout(set = 0, binding = 5) uniform sampler2D u_velocity;
// Last frame's accumulation, and the linear depth it was accumulated at with
// the sample count in its low bits.
layout(set = 0, binding = 6) uniform sampler2D u_history;
layout(set = 0, binding = 7) uniform sampler2D u_history_depth;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D u_accum;
layout(set = 0, binding = 9, r32f) uniform writeonly image2D u_accum_depth;
// What a near-mirror's own ray marches and samples; see `ssr_march.glsl`.
layout(set = 0, binding = 11) uniform sampler2D u_hiz;
layout(set = 0, binding = 12) uniform sampler2D u_source;
layout(set = 0, binding = 13) uniform sampler2D u_source_full;
layout(set = 0, binding = 14) uniform sampler2D u_blue_noise;

layout(set = 0, binding = 10) uniform Ssr {
    mat4 proj;
    mat4 inv_proj;
    mat4 inv_view;
    vec4 params;   // x = frame index, y = max roughness, z = thickness
    vec4 trace;
    vec4 extent;
    vec4 env;
    vec4 env_tint;
    // Unjittered, for the reason TAA's are: the motion vectors the history is
    // also reprojected by carry no jitter.
    mat4 inv_view_proj;
    mat4 prev_view_proj;
    // x != 0 to ignore the history, y = frames a smooth surface's history may
    // average, z = frames a surface at the roughness cutoff's may, w = the mask of the
    // history depth's low bits that carry the sample count (`COUNT_BITS`)
    vec4 history;
} ssr;

#include "ssr_march.glsl"

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

float pack_history_depth(float z, uint count) {
    uint mask = uint(ssr.history.w);
    return uintBitsToFloat((floatBitsToUint(z) & ~mask) | count);
}

// YCoCg for the clip, for the reason `taa_resolve.comp` gives: a box around
// samples that differ mostly in brightness is far tighter in it than in RGB.
vec3 to_ycocg(vec3 c) {
    return vec3(
        0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
        0.5 * c.r - 0.5 * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 from_ycocg(vec3 c) {
    float t = c.x - c.z;
    return vec3(t + c.y, c.x + c.z, t - c.y);
}

// Toward the box's centre until inside, keeping the direction — as TAA does.
vec3 clip_to_box(vec3 centre, vec3 half_extent, vec3 value) {
    vec3 offset = value - centre;
    vec3 units = abs(offset / (half_extent + 1e-5));
    float longest = max(units.x, max(units.y, units.z));
    return longest > 1.0 ? centre + offset / longest : value;
}

// Catmull-Rom as five bilinear taps, as in `taa_resolve.comp`, and for its
// reason: a history resampled bilinearly every frame blurs geometrically, which
// on a mirror is a reflection that goes soft whenever the camera moves.
vec4 sample_history(vec2 uv, vec2 size) {
    vec2 position = uv * size;
    vec2 centre = floor(position - 0.5) + 0.5;
    vec2 f = position - centre;
    vec2 f2 = f * f;
    vec2 f3 = f2 * f;

    vec2 w0 = f2 - 0.5 * (f3 + f);
    vec2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
    vec2 w3 = 0.5 * (f3 - f2);
    vec2 w2 = 1.0 - w0 - w1 - w3;
    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-5));

    vec2 uv0 = (centre - 1.0) / size;
    vec2 uv12 = (centre + offset12) / size;
    vec2 uv3 = (centre + 2.0) / size;

    float k0 = w0.x * w12.y;
    float k1 = w12.x * w0.y;
    float k2 = w12.x * w12.y;
    float k3 = w3.x * w12.y;
    float k4 = w12.x * w3.y;

    vec4 sum = texture(u_history, vec2(uv0.x, uv12.y)) * k0
             + texture(u_history, vec2(uv12.x, uv0.y)) * k1
             + texture(u_history, vec2(uv12.x, uv12.y)) * k2
             + texture(u_history, vec2(uv3.x, uv12.y)) * k3
             + texture(u_history, vec2(uv12.x, uv3.y)) * k4;
    // The cubic's lobes overshoot; neither radiance nor confidence may.
    return clamp(sum / (k0 + k1 + k2 + k3 + k4), vec4(0.0), vec4(vec3(65504.0), 1.0));
}

struct Candidate {
    vec4 value;
    // How far the history there can be believed to be this surface, 0 to 1.
    float trust;
    float count;
};

// The history at `at`, trusted by how well the depth it was accumulated at
// matches the depth this surface had last frame. A different surface — the
// background a moving object uncovered — is at a different depth.
Candidate fetch_history(vec2 at, float expected, float tolerance, vec2 size) {
    Candidate c = Candidate(vec4(0.0), 0.0, 0.0);
    if (any(lessThan(at, vec2(0.0))) || any(greaterThan(at, vec2(1.0)))) {
        return c;
    }
    c.value = texture(u_history, at);
    ivec2 texel = min(ivec2(at * size), ivec2(size) - 1);
    float packed = texelFetch(u_history_depth, texel, 0).r;
    float error = abs(packed - expected) / max(expected, 1e-4);
    c.trust = 1.0 - smoothstep(0.5 * tolerance, tolerance, error);
    c.count = float(floatBitsToUint(packed) & uint(ssr.history.w));
    return c;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_accum);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    uint frame = uint(ssr.params.x);

    float depth = texelFetch(u_depth, pixel, 0).r;
    float roughness = texelFetch(u_material, pixel, 0).a;
    if (depth_is_far(depth) || roughness > ssr.params.y) {
        // A depth of zero is one no surface can match next frame, which is the
        // history a pixel with nothing to reflect should leave — and what tells
        // the composite there is nothing here to swap.
        imageStore(u_accum, pixel, vec4(0.0));
        imageStore(u_accum_depth, pixel, vec4(0.0));
        return;
    }

    vec3 p = view_pos(uv, depth);
    vec3 n = normalize(texelFetch(u_normal, pixel, 0).xyz * 2.0 - 1.0);
    vec3 v = normalize(-p);
    float n_dot_v = max(dot(n, v), 1e-4);
    float rough = clamp(roughness / max(ssr.params.y, 1e-3), 0.0, 1.0);

    // Gather the neighbouring quads' rays. This is what decides
    // whether the image is usable: one importance-sampled ray per pixel is
    // noise, and a history can only average what a *pixel* has seen over time.
    // Nine neighbours, each of which sampled a different part of the same lobe,
    // is a ninefold cut in variance available in the frame the ray was traced.
    //
    // The spread follows the roughness it is standing in for. A near-mirror
    // pixel keeps its own ray and barely borrows, because its neighbours are
    // reflecting genuinely different directions and averaging them is just
    // blur; a rough pixel borrows freely, because its lobe is wide enough that
    // the neighbours' rays are samples of the same integral.
    ivec2 quads = textureSize(u_rays, 0);
    ivec2 own_quad = pixel / 2;
    // Gentler than it would need to be alone: the trace already prefilters each
    // ray over its own cone, so a wide spatial spread here would blur by the
    // roughness a second time.
    float sigma = mix(0.45, 1.0, rough);

    // Two sweeps over the same taps: the first finds what a typical sample
    // looks like, the second weights against it. A firefly has to be measured
    // relative to its neighbours rather than against a fixed threshold —
    // exposure is metered downstream of this pass, so there is no absolute
    // scale here to compare a luminance to.
    // Indexed by the tap's place in the 3x3, with a rejected tap left at zero
    // weight, rather than packed: an array written at a running count is one
    // the compiler cannot keep in registers, and this one would go to memory.
    // A zero-weight tap adds exactly nothing to any sum below.
    vec4 taps[9];
    float lengths[9];
    float spatial[9];
    float bilateral[9];
    float mean_luma = 0.0;
    float mean_weight = 0.0;
    // A mirror takes its own ray alone, so it gathers nothing.
    float mirror = 1.0 - smoothstep(MIRROR_ROUGHNESS, GLOSSY_ROUGHNESS, roughness);
    for (int k = 0; k < 9; ++k) {
        taps[k] = vec4(0.0);
        lengths[k] = 0.0;
        spatial[k] = 0.0;
        bilateral[k] = 0.0;
        ivec2 tap = own_quad + ivec2(k % 3, k / 3) - 1;
        if (mirror >= 1.0 || any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, quads))) {
            continue;
        }
        ivec2 tap_texel = ray_texel(tap, size);
        vec2 tap_uv = (vec2(tap_texel) + 0.5) / vec2(size);
        float tap_depth = texelFetch(u_depth, tap_texel, 0).r;
        vec3 tap_n = normalize(texelFetch(u_normal, tap_texel, 0).xyz * 2.0 - 1.0);
        float tap_z = view_pos(tap_uv, tap_depth).z;

        // Distance from this pixel to where that ray started, in quads, so
        // the gather stays centred on the pixel rather than on its quad's
        // traced corner.
        vec2 offset = vec2(tap_texel - pixel) * 0.5;
        float falloff = exp(-dot(offset, offset) / (2.0 * sigma * sigma));
        // A tenth of a metre of depth disagreement halves the tap and a
        // metre kills it, measured in view space so the tolerance means the
        // same thing near and far. The normal term catches the creases
        // depth alone cannot see — two faces of a cube meeting at an edge
        // sit at the same distance and reflect completely different things.
        float agreement = exp(-abs(tap_z - p.z) * 10.0)
                        * smoothstep(0.0, 0.25, dot(tap_n, n));
        float weight = falloff * agreement;
        if (weight <= 1e-4) {
            continue;
        }

        vec4 ray = texelFetch(u_rays, tap, 0);
        taps[k] = ray;
        lengths[k] = texelFetch(u_ray_length, tap, 0).r;
        spatial[k] = weight;
        bilateral[k] = agreement;
        // Weighted by the ray's own confidence, so a neighbourhood of
        // mostly misses does not report a near-zero mean and then read
        // every genuine hit in it as a firefly.
        mean_luma += dot(ray.rgb, LUMA) * weight * ray.a;
        mean_weight += weight * ray.a;
    }
    mean_luma /= max(mean_weight, 1e-6);

    // Radiance and confidence are averaged over different denominators, and the
    // difference matters. A ray that missed carries no radiance at all, so
    // folding its zero into the colour would darken the rays that did hit
    // instead of merely saying the pixel is less sure — a half-missing
    // neighbourhood would come out a quarter strength rather than half.
    // Confidence is what records the misses; the colour is the average of what
    // was actually found.
    //
    // The clip's statistics leave the falloff out: the box has to describe the
    // neighbourhood, and with a mirror's narrow falloff it would describe one
    // ray and admit nothing else.
    vec3 radiance = vec3(0.0);
    float radiance_weight = 0.0;
    float length_sum = 0.0;
    float confidence_sum = 0.0;
    float total = 0.0;
    vec3 moment1 = vec3(0.0);
    vec3 moment2 = vec3(0.0);
    float moment_weight = 0.0;
    vec2 confidence_moments = vec2(0.0);
    float confidence_weight = 0.0;
    for (int i = 0; i < 9; ++i) {
        // A sample no brighter than the neighbourhood keeps its full weight;
        // one ten times brighter keeps a tenth of it. That is a biased
        // estimator on purpose — the alternative is an unbiased mean that
        // spends a dozen frames showing one ray's lucky hit on an emissive
        // surface as a bright dot, which is what a firefly is.
        float luma = dot(taps[i].rgb, LUMA);
        float firefly = 1.0 / (1.0 + max(0.0, luma / max(mean_luma, 1e-4) - 1.0));
        float weight = spatial[i] * firefly * taps[i].a;

        radiance += taps[i].rgb * weight;
        length_sum += lengths[i] * weight;
        radiance_weight += weight;
        confidence_sum += taps[i].a * spatial[i];
        total += spatial[i];

        float moment = bilateral[i] * firefly * taps[i].a;
        vec3 c = to_ycocg(taps[i].rgb);
        moment1 += c * moment;
        moment2 += c * c * moment;
        moment_weight += moment;
        confidence_moments += vec2(taps[i].a, taps[i].a * taps[i].a) * bilateral[i];
        confidence_weight += bilateral[i];
    }
    bool found = radiance_weight > 1e-6;
    vec3 traced = found ? radiance / radiance_weight : vec3(0.0);
    // By the radiance's own weights: the virtual point below has to be where
    // the reflection being accumulated comes from.
    float ray_length = found ? length_sum / radiance_weight : 0.0;
    float confidence = confidence_sum / max(total, 1e-6);

    if (mirror > 0.0) {
        // This pixel's own ray: the quad's, when this pixel is the one the
        // trace started from, and otherwise traced here.
        vec4 own;
        float own_length;
        if (pixel == ray_texel(own_quad, size)) {
            own = texelFetch(u_rays, own_quad, 0);
            own_length = texelFetch(u_ray_length, own_quad, 0).r;
        } else {
            own = trace_reflection(uv, depth, n, roughness, stratified(pixel, frame), own_length);
        }
        // Weighted by confidence on both sides, for the reason the gather is,
        // and held to the gather's firefly rule wherever the gather has a
        // neighbourhood to measure it against: a drawn ray that found
        // something far brighter than its neighbours did is the same lucky
        // sample whichever pass traced it.
        float own_firefly = mean_weight > 0.0
            ? 1.0 / (1.0 + max(0.0, dot(own.rgb, LUMA) / max(mean_luma, 1e-4) - 1.0))
            : 1.0;
        float gathered_weight = (1.0 - mirror) * confidence;
        float own_weight = mirror * own.a * own_firefly;
        float both = gathered_weight + own_weight;
        if (both > 1e-6) {
            traced = (traced * gathered_weight + own.rgb * own_weight) / both;
            ray_length = (ray_length * gathered_weight + own_length * own_weight) / both;
            found = true;
        }
        confidence = mix(confidence, own.a, mirror);
    }

    vec3 mean = moment1 / max(moment_weight, 1e-6);
    vec3 deviation = sqrt(max(moment2 / max(moment_weight, 1e-6) - mean * mean, vec3(0.0)));

    // Where this surface was last frame, reconstructed through the unjittered
    // matrices as TAA reconstructs the sky.
    vec4 world_h = ssr.inv_view_proj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3 world = world_h.xyz / world_h.w;
    float expected = (ssr.prev_view_proj * vec4(world, 1.0)).w;
    // A grazing surface's depth changes fastest from one pixel to the next, so
    // a reprojection a fraction of a pixel out reads as a larger error there.
    float tolerance = 0.05 / max(n_dot_v, 0.25);
    vec2 history_size = vec2(size);

    vec2 surface_uv = uv - texelFetch(u_velocity, pixel, 0).rg;
    vec2 chosen_uv = surface_uv;
    Candidate chosen = Candidate(vec4(0.0), 0.0, 0.0);
    if (mirror < 1.0) {
        chosen = fetch_history(surface_uv, expected, tolerance, history_size);
    }

    if (found && mirror < 1.0) {
        vec3 eye = ssr.inv_view[3].xyz;
        vec3 virtual_point = eye + (world - eye) * (1.0 + ray_length / max(distance(world, eye), 1e-4));
        vec4 previous = ssr.prev_view_proj * vec4(virtual_point, 1.0);
        vec2 parallax_uv = previous.w > 0.0 ? (previous.xy / previous.w) * 0.5 + 0.5 : vec2(-1.0);

        // A still camera puts both candidates on the same texel, and the
        // second fetch would be the first one again.
        if (any(greaterThan(abs(parallax_uv - surface_uv) * history_size, vec2(0.5)))) {
            // The surface's depth is still what the virtual point's history is
            // tested against: on the plane of a mirror, where this candidate is
            // the right one, the texel it lands on is that same plane.
            Candidate parallax = fetch_history(parallax_uv, expected, tolerance, history_size);
            // Distance from the neighbourhood in its own standard deviations,
            // so the comparison has no absolute scale in it.
            vec3 scale = deviation + 1e-3 * mean.x + 1e-6;
            float off_surface = length((to_ycocg(chosen.value.rgb) - mean) / scale);
            float off_parallax = length((to_ycocg(parallax.value.rgb) - mean) / scale);
            bool take = parallax.trust > 0.0
                && (chosen.trust <= 0.0 || off_parallax * mix(0.5, 2.0, rough) <= off_surface);
            if (take) {
                chosen = parallax;
                chosen_uv = parallax_uv;
            }
        }
    }
    if (ssr.history.x != 0.0) {
        chosen.trust = 0.0;
    }

    vec4 history = chosen.trust > 0.0 ? sample_history(chosen_uv, history_size) : vec4(0.0);

    // Wider for rougher surfaces, whose rays scatter further from their own
    // mean and whose history is the better estimate of the two.
    float gamma = mix(1.25, 2.5, rough);
    if (moment_weight > 0.0) {
        history.rgb = max(from_ycocg(clip_to_box(mean, gamma * deviation, to_ycocg(history.rgb))), vec3(0.0));
    }
    // Confidence is clipped too, or a reflection whose object has moved away
    // would fade out over the whole history rather than leave with it.
    float confidence_mean = confidence_moments.x / max(confidence_weight, 1e-6);
    float confidence_deviation = sqrt(max(
        confidence_moments.y / max(confidence_weight, 1e-6) - confidence_mean * confidence_mean, 0.0));
    history.a = clamp(history.a, confidence_mean - gamma * confidence_deviation,
                      confidence_mean + gamma * confidence_deviation);

    // A pixel the history has just found converges as fast as its samples
    // arrive; a settled one stops at a length that is short for a smooth
    // surface, where a stale sharp reflection is the visible error, and long
    // for a rough one, where the noise is — and none at all for a mirror, whose
    // exact ray has no noise for a history to remove.
    float limit = roughness < MIRROR_ROUGHNESS ? 0.0 : mix(ssr.history.y, ssr.history.z, rough);
    float frames = min(chosen.count * chosen.trust, limit);
    float alpha = 1.0 / (frames + 1.0);

    // Radiance is weighted by confidence for the reason the gather weights it:
    // a frame whose rays missed says nothing about what the reflection looks
    // like, only about how much of it there is.
    float history_weight = (1.0 - alpha) * history.a;
    float current_weight = alpha * confidence;
    float weights = history_weight + current_weight;
    vec3 accumulated = weights > 1e-6
        ? (history.rgb * history_weight + traced * current_weight) / weights
        : traced;
    float accumulated_confidence = mix(history.a, confidence, alpha);
    uint next = uint(min(frames + 1.0, limit) + 0.5);

    imageStore(u_accum, pixel, vec4(accumulated, accumulated_confidence));
    imageStore(u_accum_depth, pixel, vec4(pack_history_depth(-p.z, next)));
}
