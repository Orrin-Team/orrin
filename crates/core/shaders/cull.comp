#version 460

// One invocation per (live instance, view): decide whether the instance is
// wanted by that view, and if it is, append its row to the view's list and count
// it into its batch's draw command.
//
// The two view kinds are not the same test and must not be made one. A frustum
// view -- the camera, and each face of a punctual light -- keeps a box that
// reaches into the volume it can see. A cascade keeps a box that reaches its
// volume *when swept toward the light*, which has no near plane at all: an
// object between the sun and the cascade is exactly what casts into it. Testing
// a cascade with its own six planes would drop those shadows, which is the
// mistake `systems::casts_into` documents on the CPU side.

layout(local_size_x = 64, local_size_y = 1) in;

const uint VIEW_FRUSTUM = 0;
const uint VIEW_CASCADE = 1;

struct Object {
    mat4 model;
    mat4 prev_model;
};

struct Instance {
    uint row;
    // The batch's number, not its slot: the top bit says which pipeline variant
    // draws it and the rest is its index within that variant. `slot` below is
    // what turns the pair into a row of `commands`, and it cannot be resolved
    // on the host because the split moves whenever a new plain batch appears.
    // See `BatchIds` in `gfx/vulkan/cull.rs`.
    uint batch;
};

struct Batch {
    uint index_count;
    uint first_index;
    int vertex_offset;
    uint instance_base;
    // Written into the instance entry, because the draw that reads it has no
    // push constant of its own.
    uint material;
    // The mesh's own bounds, which every instance of the batch shares -- a
    // batch is one mesh. Held here rather than per instance because that is
    // where it is stored once instead of once per object, and because the model
    // matrix beside the object row is what turns it into a world box.
    vec4 bounds_min;
    vec4 bounds_max;
};

struct View {
    // World space into light space, for a cascade. Unused by a frustum view.
    mat4 light_view;
    vec4 planes[6];
    uint kind;
    float half_extent;
    float depth_range;
    // Where this view's block of `instance_index` begins.
    uint base;
};

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(set = 0, binding = 0) readonly buffer Objects { Object objects[]; };
layout(set = 0, binding = 1) readonly buffer Instances { Instance instances[]; };
layout(set = 0, binding = 2) readonly buffer Batches { Batch batches[]; };
layout(set = 0, binding = 3) readonly buffer Views { View views[]; };
layout(set = 0, binding = 4) buffer Commands { DrawCommand commands[]; };
layout(set = 0, binding = 5) writeonly buffer Indices { uvec2 indices[]; };
// The previous frame's max-depth pyramid, half the frame at level 0. Bound
// whether or not the frame tests against it -- a one-texel image stands in when
// it does not -- because a descriptor set with a hole in it is not one Vulkan
// accepts, and the branch below is uniform across the whole dispatch.
layout(set = 0, binding = 6) uniform sampler2D u_occlusion;

layout(push_constant) uniform Push {
    uint instance_count;
    uint view_count;
    uint batch_count;
    // Where the masked batches begin, which is what a packed batch number is
    // resolved against.
    uint plain_count;
    // The camera the pyramid was rasterised through, which is the previous
    // frame's. Testing this frame's box against last frame's depth is only
    // meaningful projected the way that depth was.
    mat4 prev_view_proj;
    uint occlusion;
} push;

const uint MASKED_BIT = 0x80000000u;

// The row of `commands` a packed batch number owns this frame.
uint slot(uint packed) {
    uint index = packed & ~MASKED_BIT;
    return (packed & MASKED_BIT) != 0u ? push.plain_count + index : index;
}

// Conservative, exactly as `Frustum::intersects` is: true means "may be
// visible". `extents . |n|` is the box's support along the plane normal, so the
// box is rejected only when even its most inside corner is behind.
bool inside_frustum(View view, vec3 center, vec3 extents) {
    for (uint i = 0; i < 6; ++i) {
        vec4 plane = view.planes[i];
        if (dot(plane.xyz, center) + plane.w + dot(extents, abs(plane.xyz)) < 0.0) {
            return false;
        }
    }
    return true;
}

// The GPU half of `systems::casts_into`. `light_view` is a right-handed
// look-at, so the cascade lies at negative z between the eye at 0 and the far
// plane at -depth_range; the near side is deliberately open.
bool casts_into(View view, vec3 center, vec3 extents) {
    vec3 c = (view.light_view * vec4(center, 1.0)).xyz;
    mat3 rotation = mat3(view.light_view);
    vec3 ls = abs(rotation[0]) * extents.x + abs(rotation[1]) * extents.y + abs(rotation[2]) * extents.z;
    float half_extent = view.half_extent;
    return c.x - ls.x <= half_extent && c.x + ls.x >= -half_extent
        && c.y - ls.y <= half_extent && c.y + ls.y >= -half_extent
        && c.z + ls.z >= -view.depth_range;
}

// True only when the previous frame's depth covered this box everywhere its
// screen rect landed, so nothing it draws could have been seen.
//
// Every branch out of here returns false, and that asymmetry is the whole
// safety argument: a box this test cannot measure is drawn. It refuses four
// kinds -- one crossing the previous near plane, which the projection folds
// rather than bounds; one whose rect leaves the frame, where no depth was ever
// written; one whose rect is wider than the coarsest level can bound; and, by
// the caller, any view that is not the camera, because a cascade and a light
// face have no pyramid of their own and an object hidden from the eye still
// casts.
//
// The box is the world AABB around the instance's oriented bounds, which is
// larger than the geometry twice over -- a wider rect picks a coarser level and
// a nearer minimum depth, and both make culling *less* likely. Conservative in
// the direction that matters.
bool occluded(vec3 center, vec3 extents) {
    vec3 ndc_min = vec3(1e30);
    vec3 ndc_max = vec3(-1e30);
    for (int corner = 0; corner < 8; ++corner) {
        vec3 offset = vec3(
            (corner & 1) != 0 ? extents.x : -extents.x,
            (corner & 2) != 0 ? extents.y : -extents.y,
            (corner & 4) != 0 ? extents.z : -extents.z);
        vec4 clip = push.prev_view_proj * vec4(center + offset, 1.0);
        if (clip.w <= 0.0) {
            return false;
        }
        vec3 ndc = clip.xyz / clip.w;
        ndc_min = min(ndc_min, ndc);
        ndc_max = max(ndc_max, ndc);
    }

    if (any(lessThan(ndc_min.xy, vec2(-1.0))) || any(greaterThan(ndc_max.xy, vec2(1.0)))) {
        return false;
    }

    // Widened by a texel each way before the level is chosen. The pyramid's
    // base is the frame halved and the depth under it was rasterised through a
    // jittered projection this matrix does not carry, so the rect is known to
    // within about a texel and not better than that.
    ivec2 size = textureSize(u_occlusion, 0);
    ivec2 lo = clamp(ivec2(floor((ndc_min.xy * 0.5 + 0.5) * vec2(size))) - 1, ivec2(0), size - 1);
    ivec2 hi = clamp(ivec2(ceil((ndc_max.xy * 0.5 + 0.5) * vec2(size))), ivec2(0), size - 1);

    // The level whose texel is at least as wide as the rect, which puts the
    // rect inside two texels each way there whatever it is aligned to -- unless
    // the pyramid ran out of levels first, which is what the budget below is.
    ivec2 span = hi - lo + 1;
    int deepest = textureQueryLevels(u_occlusion) - 1;
    int level = min(int(ceil(log2(float(max(span.x, span.y))))), deepest);

    // A rect wider than the coarsest level's texel is read from that level with
    // a wider loop instead, up to a budget. The pyramid stops at a cell 64
    // frame pixels across -- one workgroup of `hiz_occlusion.comp` sees a 64x64
    // block of the depth buffer and no more -- and refusing everything past
    // that would refuse every object more than a twentieth of the screen wide.
    // Four cells each way is where the taps stop being free; past it the box is
    // drawn. Something that large on screen is usually the occluder anyway.
    ivec2 first = lo >> level;
    ivec2 last = hi >> level;
    if (any(greaterThan(last - first, ivec2(3)))) {
        return false;
    }

    float farthest = 0.0;
    for (int y = first.y; y <= last.y; ++y) {
        for (int x = first.x; x <= last.x; ++x) {
            farthest = max(farthest, texelFetch(u_occlusion, ivec2(x, y), level).r);
        }
    }

    // The cell holds the farthest of the frontmost surfaces under it. A box
    // whose nearest point is behind even that is behind a surface at every
    // texel its rect covers.
    return ndc_min.z > farthest;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint view_index = gl_GlobalInvocationID.y;
    if (index >= push.instance_count || view_index >= push.view_count) {
        return;
    }

    Instance instance = instances[index];
    Object object = objects[instance.row];
    uint batch_slot = slot(instance.batch);
    Batch batch = batches[batch_slot];
    View view = views[view_index];

    vec3 bmin = batch.bounds_min.xyz;
    vec3 bmax = batch.bounds_max.xyz;
    // A mesh with no registered bounds is unmeasurable, so it is drawn rather
    // than culled -- the same fallback the CPU sweep takes, stated here because
    // the inverted box it arrives as would otherwise make a NaN centre and fail
    // every compare instead.
    bool measurable = all(lessThanEqual(bmin, bmax));

    bool wanted = true;
    if (measurable) {
        mat3 rotation = mat3(object.model);
        vec3 center = (object.model * vec4(0.5 * (bmin + bmax), 1.0)).xyz;
        vec3 half_extents = 0.5 * (bmax - bmin);
        vec3 extents = abs(rotation[0]) * half_extents.x
            + abs(rotation[1]) * half_extents.y
            + abs(rotation[2]) * half_extents.z;
        wanted = view.kind == VIEW_CASCADE
            ? casts_into(view, center, extents)
            : inside_frustum(view, center, extents);
        // View 0 is the camera, and only the camera has a pyramid. A cascade or
        // a light face keeps what the frustum kept: an object the eye cannot see
        // still casts a shadow the eye can.
        if (wanted && push.occlusion != 0u && view_index == 0u) {
            wanted = !occluded(center, extents);
        }
    }
    if (!wanted) {
        return;
    }

    uint command = view_index * push.batch_count + batch_slot;
    uint offset = atomicAdd(commands[command].instance_count, 1);
    indices[view.base + batch.instance_base + offset] = uvec2(instance.row, batch.material);
}
