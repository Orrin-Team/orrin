#version 460

#include "depth.glsl"

// The depth pyramid the reflection trace skips empty space with: level `n` holds
// the *nearest* depth of the 2^n x 2^n block of the frame's depth buffer under
// it, so a ray that stays in front of a cell's minimum cannot have hit anything
// inside that cell and can cross the whole cell in one step.
//
// It starts at level 1. Level 0 would be a copy of the depth buffer — three
// quarters of every texel this pass writes — and the march reads the depth
// buffer itself at level 0 instead (`ssr_march.glsl`), which costs it one
// branch and saves this pass most of its traffic.
//
// One dispatch writes every level, and that is a property of the render graph
// rather than a performance choice: resources are unversioned, so a chain of
// passes each reading level n-1 and writing level n of the same image would make
// "readers after all writers" point in both directions and `compile` would
// report a cycle. A workgroup therefore owns a 64x64 tile of the frame and
// reduces it alone — the six levels need no data from outside that tile, which
// is exactly why the tile is 64 wide.
//
// 16x16 invocations, each reducing a 4x4 block with four gathers: enough
// invocations to keep the memory system busy, and few enough loads each that
// none waits behind its own. A gather at the frame's edge clamps, duplicating
// an edge texel that is already in the same cell, so the nearest depth of any
// cell is exactly that of the texels under it. An extent that is not a
// multiple of a level's cell leaves a strip along the right and bottom edges
// that level has no texel for (Vulkan floors each mip's size, and the store is
// dropped); the march knows it, and looks closer there instead of skipping it.

const int MAX_LEVELS = 6;

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D u_depth; // nearest, clamped to the edge
// One view per level, because a storage image descriptor takes exactly one mip.
// Indices are literals below, so this needs no descriptor-indexing feature.
layout(set = 0, binding = 1, r32f) uniform writeonly image2D u_mips[MAX_LEVELS];

layout(push_constant) uniform Push {
    // The depth buffer's extent.
    ivec2 extent;
    // How many levels the image was actually allocated with — a small window
    // cannot carry the full pyramid, and the trace clamps to the same number.
    int levels;
} push;

shared float lds[256];

float nearest4(float a, float b, float c, float d) {
    return depth_nearest(depth_nearest(a, b), depth_nearest(c, d));
}

float nearest4(vec4 v) {
    return nearest4(v.x, v.y, v.z, v.w);
}

// `mip` is a literal at every call site: a dynamic index into an array of
// storage images would need shaderStorageImageArrayDynamicIndexing, which is
// optional. The caller has already tested `push.levels`, once per level.
#define STORE(mip, coord, value)                                  \
    if (all(lessThan(coord, imageSize(u_mips[mip])))) {           \
        imageStore(u_mips[mip], coord, vec4(value));              \
    }

void main() {
    ivec2 group = ivec2(gl_WorkGroupID.xy);
    ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    ivec2 base = group * 64 + lid * 4;
    vec2 texel = 1.0 / vec2(push.extent);

    // Level 1, as four texels: each gather is centred on the corner its 2x2
    // block shares, which is exactly the block's footprint.
    float m1[4];
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            m1[j * 2 + i] = nearest4(textureGather(u_depth, vec2(base + ivec2(i * 2 + 1, j * 2 + 1)) * texel));
        }
    }
    if (push.levels > 0) {
        ivec2 at = base >> 1;
        STORE(0, at, m1[0])
        STORE(0, at + ivec2(1, 0), m1[1])
        STORE(0, at + ivec2(0, 1), m1[2])
        STORE(0, at + ivec2(1, 1), m1[3])
    }

    float m2 = nearest4(m1[0], m1[1], m1[2], m1[3]);
    if (push.levels > 1) {
        STORE(1, base >> 2, m2)
    }

    // Past level 2 a texel spans more than one invocation's block, so the
    // reduction moves into shared memory. Every barrier is in uniform control
    // flow; only the stores are predicated.
    int slot = lid.y * 16 + lid.x;
    lds[slot] = m2;
    barrier();

    if ((lid.x & 1) == 0 && (lid.y & 1) == 0) {
        float v = nearest4(lds[slot], lds[slot + 1], lds[slot + 16], lds[slot + 17]);
        lds[slot] = v;
        if (push.levels > 2) {
            STORE(2, group * 8 + (lid >> 1), v)
        }
    }
    barrier();

    if ((lid.x & 3) == 0 && (lid.y & 3) == 0) {
        float v = nearest4(lds[slot], lds[slot + 2], lds[slot + 32], lds[slot + 34]);
        lds[slot] = v;
        if (push.levels > 3) {
            STORE(3, group * 4 + (lid >> 2), v)
        }
    }
    barrier();

    if ((lid.x & 7) == 0 && (lid.y & 7) == 0) {
        float v = nearest4(lds[slot], lds[slot + 4], lds[slot + 64], lds[slot + 68]);
        lds[slot] = v;
        if (push.levels > 4) {
            STORE(4, group * 2 + (lid >> 3), v)
        }
    }
    barrier();

    if (slot == 0 && push.levels > 5) {
        float v = nearest4(lds[0], lds[8], lds[128], lds[136]);
        STORE(5, group, v)
    }
}
