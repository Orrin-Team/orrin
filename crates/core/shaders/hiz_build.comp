#version 460

#include "depth.glsl"

// The depth pyramid the reflection trace skips empty space with: level `n` holds
// the *nearest* depth of the 2^n x 2^n block of the frame's depth buffer under
// it, so a ray that stays in front of a cell's minimum cannot have hit anything
// inside that cell and can cross the whole cell in one step.
//
// One dispatch writes every level, and that is a property of the render graph
// rather than a performance choice: resources are unversioned, so a chain of
// passes each reading level n-1 and writing level n of the same image would make
// "readers after all writers" point in both directions and `compile` would
// report a cycle. A workgroup therefore owns a 64x64 tile of the frame and
// reduces it alone — the first six levels need no data from outside that tile,
// which is exactly why the tile is 64 wide.

const int MAX_LEVELS = 7;

// 8x8 invocations, each owning an 8x8 block of the tile.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_depth;
// One view per level, because a storage image descriptor takes exactly one mip.
// Indices are literals below, so this needs no descriptor-indexing feature.
layout(set = 0, binding = 1, r32f) uniform writeonly image2D u_mips[MAX_LEVELS];

layout(push_constant) uniform Push {
    ivec2 extent;
    // How many levels the image was actually allocated with — a small window
    // cannot carry the full pyramid, and the trace clamps to the same number.
    int levels;
} push;

shared float lds[64];

// Outside the frame reads as the far plane, so an edge tile never claims a
// surface nearer than anything really there.
float load(ivec2 p) {
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, push.extent))) {
        return DEPTH_FAR;
    }
    return texelFetch(u_depth, p, 0).r;
}

// `level` is a literal at every call site. A dynamic index into an array of
// storage images would need shaderStorageImageArrayDynamicIndexing, which is
// optional; nothing here asks for it.
#define STORE(level, coord, value)                                \
    if (push.levels > (level)) {                                  \
        ivec2 size_ = imageSize(u_mips[level]);                   \
        if (all(lessThan(coord, size_))) {                        \
            imageStore(u_mips[level], coord, vec4(value));        \
        }                                                         \
    }

float nearest4(float a, float b, float c, float d) {
    return depth_nearest(depth_nearest(a, b), depth_nearest(c, d));
}

void main() {
    ivec2 tile = ivec2(gl_WorkGroupID.xy) * 64;
    ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    ivec2 base = tile + lid * 8;

    // Level 0 is a copy of the depth buffer rather than an alias of it: the
    // trace samples one image with `textureLod` across every level, and a
    // pyramid missing its own base would need a second binding and a special
    // case for level zero in the marching loop.
    float d[64];
    for (int j = 0; j < 8; ++j) {
        for (int i = 0; i < 8; ++i) {
            float v = load(base + ivec2(i, j));
            d[j * 8 + i] = v;
            STORE(0, base + ivec2(i, j), v)
        }
    }

    // Levels 1 to 3 come out of this invocation's own 8x8 block: a level-3 texel
    // covers exactly it. An odd frame extent loses its last column or row at the
    // coarse levels (Vulkan floors each mip's size, and the write is dropped by
    // the bounds check above), which makes the pyramid non-conservative in that
    // one strip — a ray may skip a surface there. It costs a missing reflection
    // at the very edge of the frame, where the trace's edge fade has already
    // taken the contribution to nothing.
    float m1[16];
    for (int j = 0; j < 4; ++j) {
        for (int i = 0; i < 4; ++i) {
            float v = nearest4(d[(2 * j) * 8 + 2 * i], d[(2 * j) * 8 + 2 * i + 1],
                           d[(2 * j + 1) * 8 + 2 * i], d[(2 * j + 1) * 8 + 2 * i + 1]);
            m1[j * 4 + i] = v;
            STORE(1, (base >> 1) + ivec2(i, j), v)
        }
    }

    float m2[4];
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            float v = nearest4(m1[(2 * j) * 4 + 2 * i], m1[(2 * j) * 4 + 2 * i + 1],
                           m1[(2 * j + 1) * 4 + 2 * i], m1[(2 * j + 1) * 4 + 2 * i + 1]);
            m2[j * 2 + i] = v;
            STORE(2, (base >> 2) + ivec2(i, j), v)
        }
    }

    float m3 = nearest4(m2[0], m2[1], m2[2], m2[3]);
    STORE(3, (base >> 3) + ivec2(0, 0), m3)

    // Past level 3 a texel spans more than one invocation's block, so the
    // reduction moves into shared memory. Every barrier is in uniform control
    // flow; only the stores are predicated.
    int slot = lid.y * 8 + lid.x;
    lds[slot] = m3;
    barrier();

    if ((lid.x & 1) == 0 && (lid.y & 1) == 0) {
        float v = nearest4(lds[slot], lds[slot + 1], lds[slot + 8], lds[slot + 9]);
        lds[slot] = v;
        STORE(4, ivec2(gl_WorkGroupID.xy) * 4 + (lid >> 1), v)
    }
    barrier();

    if ((lid.x & 3) == 0 && (lid.y & 3) == 0) {
        float v = nearest4(lds[slot], lds[slot + 2], lds[slot + 16], lds[slot + 18]);
        lds[slot] = v;
        STORE(5, ivec2(gl_WorkGroupID.xy) * 2 + (lid >> 2), v)
    }
    barrier();

    if (slot == 0) {
        float v = nearest4(lds[0], lds[4], lds[32], lds[36]);
        STORE(6, ivec2(gl_WorkGroupID.xy), v)
    }
}
