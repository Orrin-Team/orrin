#version 460

#include "depth.glsl"

// Swap the environment's guess at a reflection for the one the trace actually
// found.
//
// The forward pass already added a specular environment term to every surface,
// weighted by the split sum. Adding traced radiance on top of that would count
// the same light twice and make anything reflective too bright the moment a ray
// lands. So this pass subtracts the environment term and adds the traced one in
// its place, under the identical weight — where the trace is confident the
// reflection is what the screen contains, where it is not the environment stays,
// and in between the two cross-fade. That is why the weight lives in a shared
// header rather than being restated here.
//
// It also upsamples: the trace runs at half resolution, and the four nearest
// rays are combined by how well their depth agrees with this pixel's, so a
// reflection does not bleed across a silhouette the half-resolution grid cannot
// see.

#include "brdf.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_source;   // the lit frame
layout(set = 0, binding = 1) uniform sampler2D u_rays;     // half-res, rgb + confidence
layout(set = 0, binding = 2) uniform sampler2D u_depth;
layout(set = 0, binding = 3) uniform sampler2D u_normal;   // view-space, encoded
layout(set = 0, binding = 4) uniform sampler2D u_material; // rgb = f0, a = roughness
layout(set = 0, binding = 5, r11f_g11f_b10f) uniform writeonly image2D u_output;
layout(set = 0, binding = 6) uniform textureCube u_environment;
layout(set = 0, binding = 7) uniform sampler u_environment_sampler;

layout(set = 0, binding = 8) uniform Ssr {
    mat4 proj;
    mat4 inv_proj;
    mat4 inv_view;
    vec4 params;   // y = max roughness, w = intensity
    vec4 trace;
    vec4 extent;
    vec4 env;      // x = sin(yaw), y = cos(yaw), z = specular mip count
    vec4 env_tint;
} ssr;

vec3 view_pos(vec2 uv, float depth) {
    vec4 clip = ssr.inv_proj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return clip.xyz / clip.w;
}

// World space into the environment's own frame — the same rotation the skybox
// and the forward pass sample through, so the sky and what mirrors it agree.
vec3 to_environment(vec3 v) {
    float s = ssr.env.x;
    float c = ssr.env.y;
    return vec3(c * v.x - s * v.z, v.y, s * v.x + c * v.z);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_output);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec3 scene = texture(u_source, uv).rgb;

    float depth = texture(u_depth, uv).r;
    vec4 material = texture(u_material, uv);
    float roughness = material.a;
    if (depth_is_far(depth) || roughness > ssr.params.y) {
        imageStore(u_output, pixel, vec4(scene, 1.0));
        return;
    }

    vec3 p = view_pos(uv, depth);
    vec3 n = normalize(texture(u_normal, uv).xyz * 2.0 - 1.0);
    vec3 v = normalize(-p);
    float n_dot_v = max(dot(n, v), 1e-4);
    vec3 f0 = material.rgb;

    // Gather the neighbouring half-resolution rays. This is the pass's other
    // job, and the one that decides whether the image is usable: one
    // importance-sampled ray per pixel is noise, and TAA can only average what
    // a *pixel* has seen over time. Nine neighbours, each of which sampled a
    // different part of the same lobe, is a ninefold cut in variance available
    // in the frame the ray was traced.
    //
    // The spread follows the roughness it is standing in for. A near-mirror
    // pixel keeps its own ray and barely borrows, because its neighbours are
    // reflecting genuinely different directions and averaging them is just
    // blur; a rough pixel borrows freely, because its lobe is wide enough that
    // the neighbours' rays are samples of the same integral.
    vec2 ray_size = vec2(textureSize(u_rays, 0));
    vec2 ray_coord = uv * ray_size - 0.5;
    ivec2 centre = ivec2(round(ray_coord));
    // Gentler than it would need to be alone: the trace already prefilters each
    // ray over its own cone, so a wide spatial spread here would blur by the
    // roughness a second time.
    float sigma = mix(0.45, 1.0, clamp(roughness / max(ssr.params.y, 1e-3), 0.0, 1.0));

    // Two sweeps over the same taps: the first finds what a typical sample
    // looks like, the second weights against it. A firefly has to be measured
    // relative to its neighbours rather than against a fixed threshold —
    // exposure is metered downstream of this pass, so there is no absolute
    // scale here to compare a luminance to.
    vec4 taps[9];
    float spatial[9];
    float mean_luma = 0.0;
    float mean_weight = 0.0;
    int count = 0;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            ivec2 tap = centre + ivec2(i, j);
            if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(tap, ivec2(ray_size)))) {
                continue;
            }
            vec2 tap_uv = (vec2(tap) + 0.5) / ray_size;
            float tap_depth = texture(u_depth, tap_uv).r;
            vec3 tap_n = normalize(texture(u_normal, tap_uv).xyz * 2.0 - 1.0);
            float tap_z = view_pos(tap_uv, tap_depth).z;

            // Distance from this pixel's true position in ray space, so the
            // gather stays centred where the pixel is rather than on whichever
            // texel it rounded to.
            vec2 offset = vec2(tap) - ray_coord;
            float falloff = exp(-dot(offset, offset) / (2.0 * sigma * sigma));
            // A tenth of a metre of depth disagreement halves the tap and a
            // metre kills it, measured in view space so the tolerance means the
            // same thing near and far. The normal term catches the creases
            // depth alone cannot see — two faces of a cube meeting at an edge
            // sit at the same distance and reflect completely different things.
            float agreement = exp(-abs(tap_z - p.z) * 10.0)
                            * smoothstep(0.0, 0.25, dot(tap_n, n));
            float weight = falloff * agreement;
            if (weight <= 1e-4) {
                continue;
            }

            vec4 ray = texelFetch(u_rays, tap, 0);
            taps[count] = ray;
            spatial[count] = weight;
            // Weighted by the ray's own confidence, so a neighbourhood of
            // mostly misses does not report a near-zero mean and then read
            // every genuine hit in it as a firefly.
            mean_luma += dot(ray.rgb, vec3(0.2126, 0.7152, 0.0722)) * weight * ray.a;
            mean_weight += weight * ray.a;
            count++;
        }
    }
    if (mean_weight <= 0.0) {
        imageStore(u_output, pixel, vec4(scene, 1.0));
        return;
    }
    mean_luma /= mean_weight;

    // Radiance and confidence are averaged over different denominators, and the
    // difference matters. A ray that missed carries no radiance at all, so
    // folding its zero into the colour would darken the rays that did hit
    // instead of merely saying the pixel is less sure — a half-missing
    // neighbourhood would come out a quarter strength rather than half.
    // Confidence is what records the misses; the colour is the average of what
    // was actually found.
    vec3 radiance = vec3(0.0);
    float radiance_weight = 0.0;
    float confidence_sum = 0.0;
    float total = 0.0;
    for (int i = 0; i < count; ++i) {
        // A sample no brighter than the neighbourhood keeps its full weight;
        // one ten times brighter keeps a tenth of it. That is a biased
        // estimator on purpose — the alternative is an unbiased mean that
        // spends a dozen frames showing one ray's lucky hit on an emissive
        // surface as a bright dot, which is what a firefly is.
        float luma = dot(taps[i].rgb, vec3(0.2126, 0.7152, 0.0722));
        float firefly = 1.0 / (1.0 + max(0.0, luma / max(mean_luma, 1e-4) - 1.0));
        float weight = spatial[i] * firefly;

        radiance += taps[i].rgb * weight * taps[i].a;
        radiance_weight += weight * taps[i].a;
        confidence_sum += taps[i].a * spatial[i];
        total += spatial[i];
    }
    if (radiance_weight <= 1e-6) {
        imageStore(u_output, pixel, vec4(scene, 1.0));
        return;
    }

    vec3 traced = radiance / radiance_weight;
    float confidence = clamp(confidence_sum / max(total, 1e-6) * ssr.params.w, 0.0, 1.0);

    // The environment term the forward pass applied to this pixel, rebuilt from
    // the same inputs it used. View space into world for the cube lookup, which
    // is the one thing the G-buffer cannot store.
    vec3 world_n = normalize(mat3(ssr.inv_view) * n);
    vec3 world_v = normalize(mat3(ssr.inv_view) * v);
    vec3 r = to_environment(reflect(-world_v, world_n));
    float lod = roughness * (ssr.env.z - 1.0);
    vec3 environment =
        textureLod(samplerCube(u_environment, u_environment_sampler), r, lod).rgb * ssr.env_tint.rgb;

    vec2 dfg = env_brdf_approx(roughness, n_dot_v);
    vec3 weight = (f0 * dfg.x + dfg.y) * energy_compensation(f0, roughness, n_dot_v);

    vec3 color = scene + confidence * (traced - environment) * weight;
    // The subtraction is only as exact as the two estimators agree, and a
    // confident ray into a dark corner under a bright sky can take a pixel
    // below zero. Clamping here rather than letting the tonemap do it keeps a
    // negative from propagating into bloom's threshold.
    imageStore(u_output, pixel, vec4(max(color, vec3(0.0)), 1.0));
}
